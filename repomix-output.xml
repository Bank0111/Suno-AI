      const targetSec = currentSong.sections[sectionIndex] || {};

      const systemInstruction = `คุณคือ Intelligent AI Song Writer สตูดิโอนักแต่งเพลงระดับมืออาชีพ ครูเพลง และนักเขียนเพลงชั้นครู

